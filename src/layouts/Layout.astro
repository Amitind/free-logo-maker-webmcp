---
import '@/styles/global.css';
import { Toaster } from '@/components/ui/sonner';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Free Logo Maker — WebMCP-enabled SVG Editor',
	description = 'Free SVG logo editor with WebMCP tools an AI agent can drive directly, built for the OpenAI WebMCP Challenge.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="https://api.iconify.design/lucide/shapes.svg" />
	</head>
	<body class="h-screen overflow-hidden bg-background text-foreground antialiased flex flex-col">
		<slot />
		<Toaster position="bottom-right" client:idle />
	</body>
</html>
