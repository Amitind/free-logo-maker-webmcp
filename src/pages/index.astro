---
import Layout from '@/layouts/Layout.astro';
import WebMcp from '@/components/common/WebMcp.astro';
import { LogoMaker } from '@/components/LogoMaker';
---

<Layout
	title="Free Logo Maker — WebMCP-enabled SVG Editor"
	description="Free SVG logo editor with WebMCP tools an AI agent can drive directly, built for the OpenAI WebMCP Challenge."
>
	<WebMcp />
	<main class="flex-1 min-h-0">
		<LogoMaker client:only="react" totalIconsLabel="200,000+" />
	</main>
	<footer class="shrink-0 border-t border-border py-2 text-center">
		<a
			href="https://allsvgicons.com/free-logo-maker/"
			target="_blank"
			rel="noopener noreferrer"
			class="inline-block text-sm font-semibold text-foreground hover:text-muted-foreground transition-colors"
		>
			<h1 class="text-sm font-semibold">Free logo maker</h1>
		</a>
	</footer>
</Layout>
